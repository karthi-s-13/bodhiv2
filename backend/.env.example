# Database connection configuration. 
# Format: postgresql://username:password@hostname:port/database_name
# If the database does not exist, the server will attempt to auto-create it using credentials provided.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bodhi_db

# Security
SECRET_KEY=super-secret-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

